# Quetzalcoatl Environment Configuration
# Copy this to .env and fill in your values

# REQUIRED: JWT signing key. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# Database URL (default: SQLite in backend/)
DATABASE_URL=sqlite:///./quetzalcoatl.db

# CORS origins (comma-separated, or "*" for dev only)
CORS_ORIGINS=*

# Access token expiry in minutes (default: 1440 = 24h)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Bot configuration
BOT_USERNAME=narusya
BOT_DISPLAY_NAME="Narusya 🐍"